{
  "schemaVersion": 1,
  "id": "bone.aimedia.services",
  "name": "Bone AI 媒体服务",
  "version": "0.5.0",
  "description": "Agent-driven GPT image and MiniMax speech generation with encrypted configuration, durable jobs, unified records, preview/playback and permission-scoped workspace export.",
  "main": "main.js",
  "contributes": {
    "views": [
      {
        "id": "settings",
        "title": {
          "en": "Bone AI Media Services",
          "zh-CN": "Bone AI 媒体服务"
        },
        "icon": "image",
        "entry": "renderer/index.html",
        "order": 11
      }
    ],
    "commands": [
      {
        "id": "bone.aimedia.services.open",
        "title": "Bone AI 媒体服务: 打开配置",
        "keywords": [
          "bone",
          "aimedia",
          "媒体",
          "图片",
          "视频",
          "配音"
        ]
      }
    ],
    "skills": [
      "skills/ai-media-services/SKILL.md"
    ],
    "agentTools": [
      {
        "name": "get_capabilities",
        "risk": "low",
        "description": "读取媒体服务的实际执行能力、GPT 文生图约束和配置状态；不联网、不返回密钥、不生成。已配置不等于供应商实测通过。",
        "schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "list_profiles",
        "risk": "low",
        "description": "只读列出媒体服务与模型配置、默认项和加密凭据是否已设置。不返回密钥，不探测网络；配置或目录可达不等于生成可用。",
        "schema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ],
              "description": "可选媒体类型；省略返回全部"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "list_workflows",
        "risk": "low",
        "description": "只读列出本地 ComfyUI 工作流摘要与连接引用，不返回工作流正文，不执行或验证远端工作流。",
        "schema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ],
              "description": "可选媒体类型；省略返回全部"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "prepare_image",
        "risk": "medium",
        "description": "准备一张 GPT 文生图请求并持久化参数；不联网、不收费。必须指定已保存服务、配置版本和该服务的 GPT 图片模型。返回任务 ID 和请求哈希供确认。",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "description": "每次新请求生成 UUID v4；相同请求重试使用原 UUID"
            },
            "profileId": {
              "type": "string",
              "description": "已启用的 OpenAI 服务 ID"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "modelId": {
              "type": "string",
              "description": "已配置的 gpt-image-* 模型 ID"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "size": {
              "type": "string",
              "enum": [
                "1024x1024",
                "1536x1024",
                "1024x1536"
              ]
            },
            "quality": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "requestId",
            "profileId",
            "expectedRevision",
            "modelId",
            "prompt",
            "size",
            "quality"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "submit_image",
        "risk": "high",
        "description": "按准备好的任务提交一次 GPT 生图，可能收费；须已有用户授权并传 confirm=true。保持调用直至本次请求结束并保存结果，网络上限90秒。同一任务不会重复生成。超时或 unknown 不得盲目新建重试。",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "description": "prepare_image 返回的任务 ID"
            },
            "requestHash": {
              "type": "string",
              "description": "准备阶段返回的精确请求哈希"
            },
            "confirm": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          },
          "required": [
            "jobId",
            "requestHash",
            "confirm"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "get_image_job",
        "risk": "low",
        "description": "只读本地 GPT 生图任务状态与结果元数据；不联网、不重新提交。unknown 表示结果与扣费尚不确定，不代表失败或退款。",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "description": "任务 ID"
            }
          },
          "required": [
            "jobId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_image_jobs",
        "risk": "low",
        "description": "只读列出本插件的 GPT 生图记录，不读取 ComfyUI 服务端任务、不返回凭据或私有路径。",
        "schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "read_image_result",
        "risk": "low",
        "description": "分块读取已成功生成并验证的 PNG，每次最多 64 KiB 的 Base64；校验结果哈希，无网络请求。Agent 用自身获准的文件工具保存，不读取插件私有目录。",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "description": "成功任务 ID"
            },
            "expectedSha256": {
              "type": "string",
              "description": "任务结果的 SHA-256"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "字节偏移，从 0 开始，后续使用 nextOffset"
            }
          },
          "required": [
            "jobId",
            "expectedSha256",
            "offset"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "media_catalog",
        "risk": "low",
        "description": "查询本插件已配置的媒体模型、稳定 modelRef、默认项、参数范围与不可用原因。Agent 生图或语音生成先调用此工具。只读、不联网、不返回密钥；配置可用不等于供应商实测通过。",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "planSafeActions": [
          "list"
        ]
      },
      {
        "name": "generate_image",
        "risk": "high",
        "description": "按用户已授权的要求，用已配置 GPT 模型生成一张 PNG。可能收费；无需面板。modelRef 可指定模型，省略按会话选择、默认、唯一候选解析。相同 requestKey 重试不重复生成。新提交保持调用直到请求结束（网络上限90秒）并保存结果；waitMs 仅用于已有任务的本地等待。完成返回图片，否则返回原任务状态，unknown 不得盲目新建重试。",
        "schema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "requestKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
              "description": "稳定请求名，如 blue-cup-1；相同请求重试不变，不能因超时更换"
            },
            "modelRef": {
              "type": "string",
              "description": "media_catalog 返回的完整 modelRef；用户指定模型时必须提供"
            },
            "size": {
              "type": "string",
              "enum": [
                "1024x1024",
                "1536x1024",
                "1024x1536"
              ]
            },
            "quality": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "waitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "description": "已有任务的本地等待；不截断本次新提交的网络请求"
            }
          },
          "required": [
            "prompt",
            "requestKey"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "image_job",
        "risk": "low",
        "description": "读取当前会话的既有生图任务；wait 有限等待最多15秒，result 返回已验证图片内容块（大图提示导出），list 不含提示词。全部为本地只读，不重新提交。unknown 不代表失败或退款，不能盲目新建重试。",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "get",
                "wait",
                "list",
                "result"
              ]
            },
            "jobId": {
              "type": "string"
            },
            "waitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15000
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "planSafeActions": [
          "get",
          "wait",
          "list",
          "result"
        ]
      },
      {
        "name": "export_image_result",
        "risk": "medium",
        "description": "将当前会话已生成图片写入授权工作区 bone-media/exports 下的唯一交接文件，返回解码命令和哈希；Agent 用自身获准的执行工具生成原始 PNG。无生成费用，不返回 Base64 文本，不允许任意目标路径或覆盖现有 PNG。缺少工作区或权限时导出单独报错。",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string"
            }
          },
          "required": [
            "jobId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "generate_audio",
        "risk": "high",
        "description": "按用户授权用已配置 MiniMax 语音模型将 text 朗读为一段 MP3，可能收费。仅 operation=speech；不支持脚步、环境音效或音乐，不得将音效描述当作朗读文本。必须明确 voiceId，可先查询 audio_voices。稳定 requestKey 防止重复提交。新请求保持调用至网络/保存结束（网络上限90秒）；unknown 不得新建重试。成功后导出音频。",
        "schema": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "speech"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "需要逐字朗读的文本，不是音效描述"
            },
            "voiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "明确指定的 MiniMax 音色 ID，可通过 audio_voices 查询"
            },
            "requestKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
              "description": "相同请求重试保持原值，不因超时换名"
            },
            "modelRef": {
              "type": "string"
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "waitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "operation",
            "text",
            "voiceId",
            "requestKey"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "audio_job",
        "risk": "low",
        "description": "只读当前会话语音任务；wait 最多15秒，result 核对已保存 MP3 后返回元数据和导出入口，list 不含朗读文本。不联网、不生成、不返回 Base64。unknown 不代表失败或退款。",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "get",
                "wait",
                "list",
                "result"
              ]
            },
            "jobId": {
              "type": "string"
            },
            "waitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15000
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "planSafeActions": [
          "get",
          "wait",
          "list",
          "result"
        ]
      },
      {
        "name": "export_audio_result",
        "risk": "medium",
        "description": "导出当前会话已生成 MP3 到授权工作区 bone-media/exports。返回唯一交接文件和固定解码命令，Agent 用获准执行工具生成原始音频并核对哈希。无生成费用，不返回 Base64，不接受任意目标路径或覆盖已有文件。",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string"
            }
          },
          "required": [
            "jobId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "audio_voices",
        "risk": "medium",
        "description": "按已配置 MiniMax 语音 modelRef 显式联网查询可用音色 ID 和名称；不生成、不修改默认音色、不返回密钥。供用户选择 generate_audio 的 voiceId。",
        "schema": {
          "type": "object",
          "properties": {
            "modelRef": {
              "type": "string",
              "description": "media_catalog 返回的 MiniMax 语音模型引用"
            }
          },
          "required": [
            "modelRef"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": [
    "ui.view",
    "agent.tool.register",
    "agent.prompt.inject",
    "net.fetch",
    "net.anyHost",
    "fs.read",
    "fs.write"
  ],
  "fs": {
    "read": {
      "root": "workspace",
      "scope": [
        "bone-media/exports/**"
      ]
    },
    "write": {
      "root": "workspace",
      "scope": [
        "bone-media/exports/**"
      ]
    }
  },
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": [
    "onStartup"
  ]
}
